# Copy to .env and fill in. Only SEC_USER_AGENT is strongly recommended; everything else is optional.

# SEC asks automated tools to identify themselves: "<app name> <your email>"
SEC_USER_AGENT="FinanceOneStop/1.0 you@example.com"

# Protects your data and sync when the app is reachable from the internet (phone access).
APP_PASSCODE=

# Enables AI research reports in the Ideas tab (Claude + web search).
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Optional fallbacks / higher limits
FINNHUB_API_KEY=
OPENFIGI_API_KEY=

PORT=8080
# DATA_DIR=./data
# CONGRESS_MAX_FILINGS=120
