{
  "name": "finance-one-stop",
  "version": "1.0.0",
  "description": "Real-time personal finance explorer: super-investors (13F), Congress trades, social sentiment, insider buys, headlines and AI research reports.",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "check": "node --check server/index.js && node server/selftest.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "pdf-parse": "1.1.1"
  }
}
